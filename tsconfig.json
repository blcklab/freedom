{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ES2019", "DOM"],

    "strict": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": false,

    "sourceMap": false,

    "rootDir": "./src",
    "outDir": "./dist",

    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}