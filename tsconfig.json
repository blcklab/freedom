{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ES2022", "DOM"],

    "strict": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "skipLibCheck": true,
    "verbatimModuleSyntax": true,

    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}