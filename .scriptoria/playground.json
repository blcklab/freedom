{
  "$schema": "https://scriptoria.dev/schemas/v0.16/playground.schema.json",
  "title": "freeDOM Interactive Playground",
  "description": "Real DOM examples for draggable, resizable, dockable, managed, and snapping interfaces.",
  "defaultPlugin": "freedom-window",
  "plugins": [
    {
      "id": "freedom-window",
      "label": "freeDOM Window",
      "description": "Interactive draggable, resizable, bounded, dockable, and persistent windows.",
      "adapter": "dom",
      "asset": {
        "provider": "jsdelivr-npm",
        "package": "@blcklab/freedom",
        "version": "0.2.1",
        "path": "dist/index.js"
      },
      "examplesRoot": ".scriptoria/playground/dom/freedom-window/examples",
      "defaultExample": "draggable-window",
      "examples": [
        {
          "id": "draggable-window",
          "label": "Draggable Window",
          "group": "Getting Started",
          "order": 10
        },
        {
          "id": "resizable-window",
          "label": "Resizable Window",
          "group": "Getting Started",
          "order": 20
        },
        {
          "id": "custom-drag-handle",
          "label": "Custom Drag Handle",
          "group": "Core Interaction",
          "order": 30
        },
        {
          "id": "container-bounds",
          "label": "Container Bounds",
          "group": "Bounds & Positioning",
          "order": 40
        },
        {
          "id": "centered-window",
          "label": "Centered First Render",
          "group": "Bounds & Positioning",
          "order": 50
        },
        {
          "id": "resize-handles",
          "label": "Resize Handle Sets",
          "group": "Core Interaction",
          "order": 60
        },
        {
          "id": "programmatic-api",
          "label": "Programmatic API",
          "group": "Instance API",
          "order": 70
        },
        {
          "id": "events-monitor",
          "label": "Window Events",
          "group": "Instance API",
          "order": 80
        },
        {
          "id": "window-modes",
          "label": "Minimize, Maximize & Restore",
          "group": "Window State",
          "order": 90
        },
        {
          "id": "docking-zones",
          "label": "Docking Zones",
          "group": "Docking & Persistence",
          "order": 100
        },
        {
          "id": "memory-persistence",
          "label": "Persistence with Custom Storage",
          "group": "Docking & Persistence",
          "order": 110
        },
        {
          "id": "multiple-windows",
          "label": "Multiple Windows",
          "group": "Real-World Examples",
          "order": 120
        }
      ]
    },
    {
      "id": "freedom-manager",
      "label": "Window Manager",
      "description": "Real focus, registration, event, and z-index behavior from the manager subpath.",
      "adapter": "dom",
      "asset": {
        "provider": "jsdelivr-npm",
        "package": "@blcklab/freedom",
        "version": "0.2.1",
        "path": "dist/manager.js"
      },
      "examplesRoot": ".scriptoria/playground/dom/freedom-manager/examples",
      "defaultExample": "focus-stack",
      "examples": [
        {
          "id": "focus-stack",
          "label": "Focus Stack",
          "group": "Manager API",
          "order": 10
        },
        {
          "id": "dynamic-registration",
          "label": "Register & Unregister",
          "group": "Manager API",
          "order": 20
        },
        {
          "id": "manager-events",
          "label": "Manager Events",
          "group": "Manager API",
          "order": 30
        }
      ]
    },
    {
      "id": "freedom-snap",
      "label": "Snap Plugin",
      "description": "Interactive drag surfaces powered by the real snap plugin subpath.",
      "adapter": "dom",
      "asset": {
        "provider": "jsdelivr-npm",
        "package": "@blcklab/freedom",
        "version": "0.2.1",
        "path": "dist/snap.js"
      },
      "examplesRoot": ".scriptoria/playground/dom/freedom-snap/examples",
      "defaultExample": "viewport-snap",
      "examples": [
        {
          "id": "viewport-snap",
          "label": "Workspace Edge Snap",
          "group": "Snap Interaction",
          "order": 10
        },
        {
          "id": "custom-target",
          "label": "Custom Snap Target",
          "group": "Snap Interaction",
          "order": 20
        },
        {
          "id": "snap-events",
          "label": "Snap & Unsnap Events",
          "group": "Snap Events",
          "order": 30
        }
      ]
    }
  ]
}
